# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã được .gitignore chặn).

# ===== Database =====
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=diabetes_app

# ===== Flask =====
# Đặt chuỗi ngẫu nhiên đủ dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# ===== Email (SMTP) =====
# Với Gmail: bật 2FA rồi tạo App Password và dán vào SMTP_APP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
